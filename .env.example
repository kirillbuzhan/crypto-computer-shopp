# Скопируйте в .env и при необходимости измените.

# Префикс адреса, если сайт открывается не с корня домена:
# https://university.ru/crypto-lab/  ->  ROOT_PATH=/crypto-lab
ROOT_PATH=

# Подписи в шапке, подвале и на странице «О проекте»
SITE_TITLE=Криптография и теория информации
SITE_ORGANIZATION=
SITE_AUTHORS=
SITE_CONTACT_EMAIL=

# Ограничения ввода в лаборатории
MAX_MESSAGE_LENGTH=500
MAX_ELGAMAL_MESSAGE_LENGTH=200

# Число процессов сервера (обычно — число ядер процессора)
WEB_CONCURRENCY=2

# На каком адресе публиковать порт 3250:
#   0.0.0.0   — доступ снаружи напрямую (http://<сервер>:3250)
#   127.0.0.1 — только локально, наружу сайт отдаёт nginx
BIND_ADDRESS=0.0.0.0
